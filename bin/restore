#!/usr/bin/env bash
# Replay the saved commands into the panes herdr restored.
#
# This is a manual action on purpose. `herdr pane run` types the command into the pane's shell and
# presses Enter, so a restore really does start processes; nothing here should happen without being
# asked for. Save, which only reads, is the half that runs automatically.
#
# Nothing is ever started in a pane that is busy: a record whose tab has no idle pane left is
# skipped and reported, never forced into a pane that is doing something else.
set -u

# shellcheck source=bin/lib.sh
. "$(dirname "$0")/lib.sh"

command -v jq >/dev/null 2>&1 || {
    echo "jq is required" >&2
    exit 1
}

[ -f "$state_file" ] || {
    echo "nothing saved yet: $state_file" >&2
    echo "run the save action first (or let the autosave daemon run)" >&2
    exit 1
}

panes=$("$herdr" pane list 2>/dev/null) || panes=""
tabs=$("$herdr" tab list 2>/dev/null) || tabs=""
workspaces=$("$herdr" workspace list 2>/dev/null) || workspaces=""
[ -n "$panes" ] && [ -n "$tabs" ] && [ -n "$workspaces" ] || {
    echo "herdr is not answering — is the server running?" >&2
    exit 1
}

used=""
# Counted per kind: a Claude conversation (agent) and a command are different things to bring back,
# and one total hides how many of each came back.
declare -A started=([agent]=0 [command]=0) running=([agent]=0 [command]=0)
declare -A skipped=([agent]=0 [command]=0) failed=([agent]=0 [command]=0)
launched=()

# Conversations already open anywhere, gathered once: each check walks every Claude session file.
live_sessions=" $(claude_live_sessions | tr '\n' ' ') "

# Every record is read in one jq pass, one line each, with its workspace and tab already resolved.
# Fields are separated by \x1f, not a tab: a tab is IFS whitespace, so an empty field (a workspace
# with no label) would vanish and shift the ones after it. argv stays JSON, so a newline in it does
# not end the line. The loop reads from fd 3, leaving stdin alone for what it runs.
while IFS=$'\x1f' read -r want_ws_label want_tab_label want_idx want_cwd want_argv kind replayable \
    session ws_id tab_id label <&3; do
    # The same rule save applies, applied again here: a snapshot written before a rule existed
    # would otherwise keep replaying what the current version refuses to record.
    if [ "$replayable" != true ]; then
        echo "  skipped: not replayable (interactive shell or temporary path) — $label" >&2
        skipped[$kind]=$((${skipped[$kind]} + 1))
        continue
    fi

    # A Claude conversation that is already open anywhere - resumed by hand, from the picker, or by
    # herdr's own agent resume on a machine where that works - must not be opened a second time.
    # Checked by conversation id, because the argv of the running copy may be anything.
    if [ "$kind" = agent ] && [[ $live_sessions == *" $session "* ]]; then
        echo "  already running  $label"
        running[$kind]=$((${running[$kind]} + 1))
        continue
    fi

    if [ -z "$ws_id" ]; then
        echo "  skipped: no workspace $want_ws_label — $label" >&2
        skipped[$kind]=$((${skipped[$kind]} + 1))
        continue
    fi

    if [ -z "$tab_id" ]; then
        echo "  skipped: no tab $want_tab_label in $want_ws_label — $label" >&2
        skipped[$kind]=$((${skipped[$kind]} + 1))
        continue
    fi

    # Candidates: the pane that held this command, then a pane sitting in the same directory, then
    # the nearest one. Pane ids are handed out afresh on restart, so position is what is left to
    # match on — and a layout edited since the save should still land close to where it belongs.
    claimed=""
    idle_pane=""
    idle_cwd=""
    while IFS=$'\x1f' read -r pane_id cwd <&4; do
        case " $used " in *" $pane_id "*) continue ;; esac
        info=$("$herdr" pane process-info --pane "$pane_id" 2>/dev/null) || continue
        # The same leader save records (leader_jq).
        IFS=$'\x1f' read -r leader shell leader_argv < <(jq -r "$leader_jq"'.result.process_info
            | [.foreground_process_group_id // "", .shell_pid // "", (leader | .argv // null | tojson)]
            | map(tostring) | join("\u001f")' <<<"$info")
        if [ "$leader" = "$shell" ]; then
            [ -z "$idle_pane" ] && idle_pane=$pane_id idle_cwd=$cwd
        elif [ "$leader_argv" = "$want_argv" ] ||
            [ "$(typed_argv "$leader" "$shell")" = "$want_argv" ]; then
            # Compared as whole argv, not by program name: `watch w` and
            # `watch 'df -h | grep -v tmpfs'` are both watch and must not be taken for each other.
            # A command started through a nix wrapper is recorded as typed, so it is compared as typed
            # too (typed_argv) — its raw argv carries the wrapper's flags and would never match.
            claimed=$pane_id
            break
        fi
    done 4< <(jq -r --arg t "$tab_id" --arg c "$want_cwd" --argjson w "$want_idx" '
        [.result.panes[] | select(.tab_id == $t)]
        | to_entries
        | sort_by([(.key != $w), (.value.foreground_cwd != $c and .value.cwd != $c),
                   (if .key - $w < 0 then $w - .key else .key - $w end)])
        | .[].value | [.pane_id, .foreground_cwd // .cwd // ""] | join("\u001f")' <<<"$panes")

    if [ -n "$claimed" ]; then
        echo "  already running  $label"
        used="$used $claimed"
        running[$kind]=$((${running[$kind]} + 1))
        continue
    fi

    if [ -z "$idle_pane" ]; then
        echo "  skipped: no idle pane in $want_ws_label/$want_tab_label — $label" >&2
        skipped[$kind]=$((${skipped[$kind]} + 1))
        continue
    fi

    # `herdr pane run` types the command into the pane's shell, so every word has to survive one
    # shell round trip: printf %q keeps `watch 'df -h | grep -v tmpfs'` from being split at the pipe,
    # and writes a newline as $'\n', so a script handed to watch whole stays one word on one line.
    # The words are read NUL-separated: one per line would cut such a word apart (#6).
    mapfile -d '' -t words < <(jq -j '.[] | . + "\u0000"' <<<"$want_argv")
    typed=()
    for word in "${words[@]}"; do
        printf -v word '%q' "$word"
        typed+=("$word")
    done

    # The pane comes back in the directory herdr restored, which is the pane's own cwd rather than
    # the directory the command was started from. Move first when they differ.
    if [ -n "$want_cwd" ] && [ "$want_cwd" != "$idle_cwd" ]; then
        printf -v word '%q' "$want_cwd"
        typed=(cd "$word" '&&' "${typed[@]}")
    fi

    # The leading ' ' keeps the replayed command out of the shell's history, where it would otherwise
    # pile up as lines nobody typed - `claude --resume <uuid>` worst of all, since that uuid is noise
    # no one will ever search for. Both zsh (HIST_IGNORE_SPACE) and bash (HISTCONTROL=ignorespace)
    # drop a line starting with a space; a shell without the option records the command as before, so
    # this costs nothing where it does not help.
    if "$herdr" pane run "$idle_pane" ' ' "${typed[@]}" >/dev/null 2>&1; then
        used="$used $idle_pane"
        launched+=("$idle_pane"$'\t'"$kind"$'\t'"$label")
    else
        echo "  failed  $label" >&2
        failed[$kind]=$((${failed[$kind]} + 1))
    fi
done 3< <(jq -r --arg ephemeral "$ephemeral_dirs" --arg exclude "$exclude_names" \
    --argjson workspaces "$workspaces" --argjson tabs "$tabs" "$replayable_jq$record_jq"'
    .[]
    # The workspace by id first — ids survive a restart (session.json keeps them) — then by its name,
    # which covers a workspace that was closed and made again.
    | . as $r
    | ($workspaces.result.workspaces
        | map(select(.workspace_id == $r.ws)) + map(select(($r.ws_label // "") != "" and .label == $r.ws_label))
        | first | .workspace_id // "") as $ws_id
    # Inside it, the tab by its number (kept across restarts in public_tab_numbers), then by its name.
    # The name alone is not enough: an unnamed tab is labelled with its number, so they all look alike.
    | ([$tabs.result.tabs[] | select(.workspace_id == $ws_id)]
        | map(select(.number == $r.tab)) + map(select(($r.tab_label // "") != "" and .label == $r.tab_label))
        | first | .tab_id // "") as $tab_id
    | [.ws_label // "", .tab_label // "", .idx // 0, .cwd // "", (.argv | tojson),
       (if is_agent then "agent" else "command" end), (.argv | replayable), .argv[2] // "",
       $ws_id, $tab_id, record_line]
    | map(tostring) | join("\u001f")' "$state_file" 2>/dev/null)

# `pane run` succeeding only means the text was typed. Whether the command then kept running is a
# separate question, and the one that matters: a command whose file is gone (a script deleted since,
# a temp path) is typed fine, fails at once, and leaves the pane back at its prompt. So look again
# after a moment and count only what is still running, rather than reporting every keystroke as a
# restore. All launches are checked together after one wait, not one wait per pane.
if [ "${#launched[@]}" -gt 0 ]; then
    sleep "$(config_value verify_delay 1.5)"
    for entry in "${launched[@]}"; do
        pane_id=${entry%%$'\t'*}
        rest=${entry#*$'\t'}
        kind=${rest%%$'\t'*}
        label=${rest#*$'\t'}
        info=$("$herdr" pane process-info --pane "$pane_id" 2>/dev/null) || info=""
        if [ -n "$info" ] && [ "$(jq '.result.process_info
            | .foreground_process_group_id != .shell_pid' <<<"$info")" = true ]; then
            echo "  restored  $label"
            started[$kind]=$((${started[$kind]} + 1))
        else
            echo "  exited right away (see the pane)  $label" >&2
            failed[$kind]=$((${failed[$kind]} + 1))
        fi
    done
fi

# The snapshot has been used, so autosave may track the session again. Lifted whatever the counts
# say: a record that was skipped or failed will not do better on a second try, and keeping the hold
# would only leave autosave off for the rest of the session.
rm -f "$hold_file"

tally() {
    printf '%s restored, %s already running, %s skipped, %s failed' \
        "${started[$1]}" "${running[$1]}" "${skipped[$1]}" "${failed[$1]}"
}
echo "agent(s):   $(tally agent)"
echo "command(s): $(tally command)"
notify "Pane commands restored" "agent(s): $(tally agent) / command(s): $(tally command)"
exit 0
